# NVIDIA Build API key (server only; never use NEXT_PUBLIC_).
NVIDIA_API_KEY=
# Exact NVIDIA Build model ID. Confirm hosted access for your account.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Live calls on Vercel fail closed until you configure edge rate limits.
# See README before enabling.
PUBLIC_DEMO_PROTECTED=false
